<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="wrapper">
  <div class="content">
    <div class="container">
      <br>

      <!-- Mensagens -->
      <% if ((success && success.length > 0) || (error && error.length > 0)) { %>
        <div class="msg-container">
          <% if (success && success.length > 0) { %>
            <div class="msg success"><%= success[0] %></div>
          <% } %>

          <% if (error && error.length > 0) { %>
            <div class="msg error"><%= error[0] %></div>
          <% } %>
        </div>
      <% } %>

      <div class="card">
        <div class="card-header">
          <h1 class="text-center">Editar Artigo</h1>
        </div>

        <div class="card-body">
          <!-- ⚠️ IMPORTANTE: enctype -->
          <form action="/articles/update" method="POST" enctype="multipart/form-data">

            <!-- Título -->
            <div class="mb-3">
              <label for="title" class="form-label">Nome do Artigo</label>
              <input type="text" class="form-control" id="title" name="title" value="<%= article.title %>" required>
            </div>

            <!-- ✅ INPUT DE IMAGEM CORRIGIDO -->
            <div class="mb-3">
              <label for="image" class="form-label">Imagem do Artigo</label>
              <input
                type="file"
                id="image"
                name="image"
                class="form-control"
                accept="image/*"
              >
              <div class="card-img-edit mt-3">
                <img
                  src="<%= article.image %>"
                  class="card-img-top"
                  alt="<%= article.title %>"
                />
              </div>
            </div>

            <!-- Conteúdo -->
            <div class="mb-3">
              <label class="form-label">Conteúdo</label>
              <textarea
                class="form-control"
                name="body"
                id="articles"
                placeholder="Escreva aqui o seu conteúdo"
              ></textarea>
            </div>

            <!-- Categorias -->
            <div class="mb-3">
              <label for="category" class="form-label">Categorias</label>
              
              <select class="form-control" name="category" id="category" required>
                <% categories.forEach(category => { %>
                  <% if(category.id == article.category_id) { %>
                    <option value="<%= category.id %>" selected><%= category.title %></option>
                  <% } else { %>
                    <option value="<%= category.id %>"><%= category.title %></option>
                  <% } %>
                <% }) %>
              </select>
            </div>

            <input type="hidden" name="id" value="<%= article.id %>">
            <button type="submit" class="btn btn-primary">
              Editar Artigo
            </button>

          </form>
        </div>
      </div>
    </div>
  </div>
<div id="content" style="display: none;">
    <%- article.body %>
</div>

  <%- include('../partials/footer') %>
</div>

<!-- TinyMCE -->
<script src="https://cdn.tiny.cloud/1/p34esni0kv6yvziliikta52dfu0ehl9p0rpknihzcz204drt/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script>

<script>
tinymce.init({
  language: 'pt_BR',
  selector: '#articles',
  height: 400,
  plugins: 'advlist autolink link image preview hr searchreplace wordcount fullscreen insertdatetime media table emoticons',

  init_instance_callback: () => {
    const content = document.getElementById('content').innerHTML;
    tinymce.get('articles').setContent(content);
  }
});
</script>
