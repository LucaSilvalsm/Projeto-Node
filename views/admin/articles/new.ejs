<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="wrapper">
  <div class="content">
    <div class="container">
      <br />

      <!-- Mensagens -->
      <% if ((success && success.length > 0) || (error && error.length > 0)) { %>
      <div class="msg-container">
        <% if (success && success.length > 0) { %>
        <div class="msg success"><%= success[0] %></div>
        <% } %>

        <% if (error && error.length > 0) { %>
        <div class="msg error"><%= error[0] %></div>
        <% } %>
      </div>
      <% } %>

      <div class="card">
        <div class="card-header">
          <h1 class="text-center">Novo Artigo</h1>
        </div>

        <div class="card-body">
          <!-- ⚠️ IMPORTANTE: enctype -->
          <form action="/articles/save" method="POST" enctype="multipart/form-data">
            <!-- Título -->
            <div class="mb-3">
              <label for="title" class="form-label">Nome do Artigo</label>
              <input
                type="text"
                class="form-control"
                id="title"
                name="title"
                placeholder="Nome do Artigo"
                required
              />
            </div>

            <!-- ✅ INPUT DE IMAGEM CORRIGIDO -->
            <div class="mb-3">
              <label for="image" class="form-label">Imagem do Artigo</label>
              <input type="file" id="image" name="image" class="form-control" accept="image/*" />
            </div>

            <!-- Conteúdo -->
            <div class="mb-3">
              <label class="form-label">Conteúdo</label>
              <textarea
                class="form-control"
                name="body"
                id="articles"
                placeholder="Escreva aqui o seu conteúdo"
              ></textarea>
            </div>

            <!-- Categorias -->
            <div class="mb-3">
              <label for="category" class="form-label">Categorias</label>
              <select class="form-control" name="category" id="category" required>
                <% categories.forEach(function(category) { %>
                <option value="<%= category.id %>"><%= category.title %></option>
                <% }) %>
              </select>
            </div>

            <button type="submit" class="btn btn-primary">Criar Artigo</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>
</div>

<!-- TinyMCE -->
<script
  src="https://cdn.tiny.cloud/1/p34esni0kv6yvziliikta52dfu0ehl9p0rpknihzcz204drt/tinymce/7/tinymce.min.js"
  referrerpolicy="origin"
></script>

<script>
  tinymce.init({
    language: 'pt_BR',
    selector: '#articles',
    height: 400,
    plugins:
      'advlist autolink link image preview hr searchreplace wordcount fullscreen insertdatetime media table emoticons',
  });
</script>
