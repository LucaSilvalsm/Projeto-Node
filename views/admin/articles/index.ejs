<%- include('../partials/header') %> 
<%- include('../partials/navbar') %>

<div class="wrapper">
  <!-- O conteúdo principal da página vai aqui -->
  <div class="content">
    <div class="container">
      <br />

      <!-- Exibindo mensagens de sucesso e erro -->
      <div class="container">
        <% if (success.length > 0 || error.length > 0) { %>
        <div class="msg-container">
          <% if (success.length > 0) { %>
          <div class="msg success"><%= success[0] %></div>
          <% } %> 
          <% if (error.length > 0) { %>
          <div class="msg error"><%= error[0] %></div>
          <% } %>
        </div>
        <% } %>
      </div>

      <div class="card">
        <div class="card-header">
          <h1 class="text-center">Artigos</h1>
        </div>
        <div class="card-body">
          <a type="submit" href="/admin/articles/new" class="btn btn-primary">
            Criar Artigos
          </a>
        </div>
      </div>
      <hr />

      <table class="table table-striped">
        <thead>
          <tr>
            <th scope="col"># ID</th>
            <th scope="col">Titulo</th>            
            <th scope ="col">Categoria</th>
            <th scope="col">Slug</th>
            <th scope="col">Ação</th>
          </tr>
        </thead>
        <tbody>
          <% articles.forEach(articles => { %>
          <tr>
            <th scope="row"><%= articles.id %></th>
            <td><%= articles.title %></td>   
            <td><%= articles.category.title %></td>        
            <td><%= articles.slug %></td>
            <td>
             <form action="/articles/delete" method="post" class="delete-form">
                <input type="hidden" name="id" value="<%= articles.id %>">
                <!-- garante que 'acao' seja enviado mesmo com form.submit() -->
                <input type="hidden" name="acao" value="deletar">

                <a href="/admin/articles/edit/<%= articles.id %>" class="btn btn-warning">Editar</a>
                <button type="button" class="btn btn-danger" onclick="abrirModal(this.form)">Apagar</button>
              </form>            
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal Bootstrap -->
<!-- Modal Bootstrap -->
<div class="modal" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title" id="confirmModalLabel">Confirmação</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body text-center">
        Tem certeza que deseja deletar esta categoria?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Não</button>
        <button type="button" class="btn btn-danger" id="confirmYes">Sim</button>
      </div>
    </div>
  </div>
</div>

  <!-- Rodapé -->
  <%- include('../partials/footer') %>
</div>

<script>
  let formToSubmit = null;

  function abrirModal(form) {
    formToSubmit = form;
    const modal = new bootstrap.Modal(document.getElementById("confirmModal"));
    modal.show();
  }

  document.getElementById("confirmYes").addEventListener("click", () => {
    if (formToSubmit) formToSubmit.submit(); // agora envia id + acao
  });
</script>