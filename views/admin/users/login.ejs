<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="wrapper">
  <div class="content">
    <div class="container">
      <br />

      <div class="container">
        <% if (success.length > 0 || error.length > 0) { %>
        <div class="msg-container">
          <% if (success.length > 0) { %>
          <div class="msg success"><%= success[0] %></div>
          <% } %>

          <% if (error.length > 0) { %>
          <div class="msg error"><%= error[0] %></div>
          <% } %>
        </div>
        <% } %>
      </div>

      <div class="card">
        <div class="card-header">
          <h1 class="text-center">Login</h1>
        </div>
        <div class="card-body">
          <form action="/users/login" method="POST">            
            <div class="form-group">
              <label for="email">Email</label>
              <input
                type="email"
                name="email"
                class="form-control"
                placeholder="email@dominio.com.br"
              />
            </div>
            <div class="form-group">
              <label for="password">Senha</label>
              <input type="password" name="password" class="form-control" />
            </div>
            <button class="btn btn-success w-100 text-center">Login</button>
            <a class="btn btn-success w-100 text-center" href="/admin/users/create">Não tem uma conta? Cadastre-se aqui</a>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
